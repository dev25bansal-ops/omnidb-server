# Build artefacts
*.whl
*.tar.gz

# Generated by the test suite and bench scripts; not source of truth.
pytest_out.txt
soak_*.txt
bench/soak-results*.txt
bench/results.md

# Scratch trees from benchmark and audit runs. They live outside this repo
# (at the workspace root, D:\OMNIDB) so no tool can enforce the boundary —
# see ../WORKSPACE.md for what each one is and what is safe to delete.
_qcr/
_w3*/
_verify*/
_f1_snap/
.omni-audit/

# CE study run state: the lock names a live PID and the log is a live stream.
# Both are transient runtime state, not evidence; the run config and score
# artifacts beside them are the record.
bench/ce-study-runs/**/runner.lock
bench/ce-study-runs/**/*.log

# Raw per-query score streams (>500MB each; published with the Zenodo data release,
# while test-summary.json, frozen-parameters.json, and run-config.json are in-repo).
bench/ce-study-runs/**/*-scores.jsonl
bench/ce-study-runs/**/*-results.jsonl
